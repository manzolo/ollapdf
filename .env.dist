# Environment variables for OllaPDF application
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL_NAME=llama2
DEFAULT_TEMPERATURE=0.1
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_TOP_K=4

# Embeddings: for questions in another language than the documents use a multilingual
# model. On Italian questions over English papers BAAI/bge-m3 retrieved best (18/20 vs 13/20
# for the default); paraphrase-multilingual-MiniLM-L12-v2 did worse than the default.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# System prompt: empty = built-in default. {context} is where the retrieved chunks go
# (appended if missing); other braces are kept literally, so LaTeX is fine.
# Example: SYSTEM_PROMPT=Answer in the language of the question. For formulas use LaTeX between \[ and \]. Context: {context}
SYSTEM_PROMPT=

# Cap on the tokens of one answer, thinking included (0 = no cap). Without it a model that
# loops keeps generating until LLM_TIMEOUT.
MAX_RESPONSE_TOKENS=8192

# OCR Settings (optional - for scanned PDFs)
OCR_API_URL=http://dots-ocr:8000
OCR_API_TOKEN=your-secret-token-here
OCR_MIN_TEXT_LENGTH=50